{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleela.dev/os-sensitivity/shapes-1.0.json",
  "title": "OS.Sensitivity shapes descriptor",
  "description": "Schema for shapes.json, the machine-readable OS-shape descriptor that the SLeeLa OS Creator (SLOSSensitivitySource / SLOSSensitivityFetch) resolves to fetch OS-grade C/C++ source for a chosen shape.",
  "type": "object",
  "required": ["warehouse", "contractVersion", "shapes"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "warehouse": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "compliance": { "type": "string", "minLength": 1 },
    "shapes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/shape" }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path (POSIX separators, no leading slash, no .. traversal).",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX-style license identifier or short expression."
    },
    "component": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "role": { "type": "string", "minLength": 1 },
        "component": { "type": "string" },
        "license": { "$ref": "#/$defs/license" },
        "pinnedRef": { "type": "string" },
        "upstream": { "type": "string" },
        "runsOn": { "type": "string" },
        "buildEntry": { "type": "string" },
        "sources": { "$ref": "#/$defs/relPath" },
        "cleanRoom": { "type": "boolean" },
        "members": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "upstream": { "type": "string" },
              "license": { "$ref": "#/$defs/license" },
              "component": { "type": "string" }
            }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "required": ["title", "root", "status"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/relPath" },
        "status": { "type": "string", "enum": ["populated", "partial", "planned", "empty"] },
        "compliance": { "$ref": "#/$defs/relPath" },
        "licenses": { "$ref": "#/$defs/relPath" },
        "sources": { "$ref": "#/$defs/relPath" },
        "build": { "$ref": "#/$defs/relPath" },
        "notMicrosoftWindows": { "type": "boolean" },
        "notAppleMacOS": { "type": "boolean" },
        "cleanRoom": { "type": "boolean" },
        "openSourceDarwin": { "type": "boolean" },
        "noAppleEulaDependency": { "type": "boolean" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/component" }
        },
        "paths": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/component" }
        }
      }
    }
  }
}
