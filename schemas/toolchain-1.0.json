{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sleela.dev/os-sensitivity/toolchain-1.0.json",
  "title": "OS.Sensitivity shape toolchain manifest",
  "description": "Schema for a per-shape toolchain.json: the pinned, reproducible build environment the SLeeLa OS Creator provisions before invoking the shape orchestrator to compile an artifact.",
  "type": "object",
  "required": ["shape", "toolchainVersion", "hostBase", "paths", "orchestrator"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "shape": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "toolchainVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "hostBase": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": true,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "dockerfile": { "$ref": "#/$defs/relPath" },
        "bareMetalSetup": { "$ref": "#/$defs/relPath" }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["component", "buildEntry", "requires"],
        "additionalProperties": true,
        "properties": {
          "component": { "$ref": "#/$defs/relPath" },
          "pinnedRef": { "type": "string" },
          "buildEntry": { "type": "string" },
          "artifact": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": { "type": "string", "enum": ["iso", "prefix", "image", "tarball"] },
              "role": { "type": "string" },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "apt": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "required": ["script"],
      "additionalProperties": true,
      "properties": {
        "script": { "$ref": "#/$defs/relPath" },
        "usage": { "type": "string" },
        "emits": { "type": "string" }
      }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path (POSIX separators, no leading slash, no .. traversal). A leading ../ is permitted only for the $schema pointer, which is validated separately.",
      "pattern": "^(?!/)[^\\\\]+$"
    }
  }
}
